# Telegram Bot Credentials
# Get your token by talking to @BotFather on Telegram
TELEGRAM_BOT_TOKEN=your_bot_token_here

# Get your chat ID (The Group or Channel ID where you've added your bot)
TELEGRAM_CHAT_ID=your_chat_id_here

# Optional: Telegram Topic ID (message_thread_id) for sending announcements to a specific thread
# TELEGRAM_TOPIC_ID=

# Optional: Override the default RSS feed URLs
# HACKER_NEWS_FEED_URL=https://thehackernews.com/feeds/posts/default
# BLEEPING_COMPUTER_FEED_URL=https://www.bleepingcomputer.com/feed/

# Optional: Path to JSON file tracking seen items (defaults to seen_items.json in the script directory)
# DB_PATH=seen_items.json
